########################################
# Настройки модуля ServerAutoShutdown
########################################
#
#    ServerAutoShutdown.Enabled
#        Описание: Включает автоматическую перезагрузку сервера по расписанию
#        По умолчанию: 0 - Выключено
#                      1 - Включено
#

ServerAutoShutdown.Enabled = 0

#
#    ServerAutoShutdown.EveryDays
#        Описание: Раз во сколько дней перезагружать сервер. Должно быть больше 0 (минимум 1 день)
#                   и меньше 366 (1 год). Не учитывается, если задан ServerAutoShutdown.Weekday.
#        По умолчанию: 1 - Каждый день
#

ServerAutoShutdown.EveryDays = 1

#
#    ServerAutoShutdown.Weekday
#        Описание: Если задано (0-6, где 0=воскресенье, 1=понедельник, ... 6=суббота), сервер
#                   будет перезагружаться только в этот день недели, в указанное время.
#                   Если значение в допустимом диапазоне (0-6) — перебивает ServerAutoShutdown.EveryDays.
#        По умолчанию: -1 (выключено, используется EveryDays)
#

ServerAutoShutdown.Weekday = -1

#
#    ServerAutoShutdown.Time
#        Описание: Время перезагрузки (в формате ЧЧ:ММ:СС, 24-часовой формат)
#        По умолчанию: 04:00:00
#

ServerAutoShutdown.Time = "11:00:00"

#
#    ServerAutoShutdown.Time2
#        Описание: Необязательное ВТОРОЕ время перезагрузки за день (ЧЧ:ММ:СС, 24-часовой формат).
#                   Оставь пустым, чтобы не использовать (по умолчанию) — тогда сервер перезагружается
#                   только по ServerAutoShutdown.Time, как и раньше, до появления этой настройки.
#                   Использует те же Weekday/EveryDays и те же настройки PreAnnounce, что и Time.
#        Пример:    "20:00:00" — второй рестарт в 20:00
#        По умолчанию: "" (не используется)
#

ServerAutoShutdown.Time2 = "23:00:00"

#
#    ServerAutoShutdown.PreAnnounce.Seconds
#        Описание: За сколько секунд до перезагрузки предупредить игроков в чате. Меньше 86400
#                   секунд (24 часа).
#        По умолчанию: 3600 (1 час)
#

ServerAutoShutdown.PreAnnounce.Seconds = 600

#
#    ServerAutoShutdown.PreAnnounce.Message
#        Описание: Текст объявления в игровом чате перед перезагрузкой. {} подставляется оставшееся время.
#        По умолчанию: "Запланированная перезагрузка сервера через {}"
#

ServerAutoShutdown.PreAnnounce.Message = "Запланированная перезагрузка сервера через {}"

#
#    ServerAutoShutdown.StartEvents
#        Описание: Запускает перечисленные через пробел ID ивентов при каждом старте сервера.
#                   Используй, если хочешь запускать ивенты вручную и не хочешь, чтобы они сбрасывались
#                   при ежедневной перезагрузке.
#        Пример:    "1 2" — запустит Праздник Солнцеворота (1) и Зимний Покров (2) при каждом старте сервера.
#        По умолчанию: ""
#

ServerAutoShutdown.StartEvents = ""
